{
  "child_agent": {
    "comment_previous_command_template": "opencode run -m opencode-go/deepseek-v4.1-flash \"{prompt}\"",
    "command_template": "claude-exe.exe -p --model claude-opus-5-5 --output-format stream-json --verbose --permission-mode bypassPermissions \"{prompt}\"",
    "timeout_seconds": 3600,
    "idle_timeout_seconds": 600
  },
  "test_command": "npm run check:sim",
  "verify_before_commit": true,
  "quality_gate": {
    "steps": [
      {
        "name": "test",
        "command": "npm run check:sim",
        "blocking": true
      }
    ],
    "child_dispatch_command": "npm run check:sim"
  },
  "max_fix_retries": 2,
  "max_parallel": 3,
  "comprehension_check": {
    "enabled": false,
    "questions_per_task": 3
  },
  "text_refine": {
    "skill": "yomiyasu",
    "mode": "dispatch"
  },
  "upstream": {
    "url": "https://github.com/Musasaby/multi-ai-agents-workflow.git",
    "branch": "main"
  },
  "review": {
    "mode": "dispatch",
    "command_template": "claude-exe.exe -p --model claude-opus-5-5 --output-format stream-json --verbose --permission-mode bypassPermissions \"{prompt}\"",
    "subagent_model": "claude-opus-5-5"
  },
  "task_sizing": {
    "max_acceptance_criteria": 5,
    "max_changed_files": 4,
    "max_reference_files": 5,
    "design_detail": "skeleton"
  }
}
